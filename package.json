{
  "name": "anoma-envio",
  "version": "3.0.1",
  "type": "module",
  "description": "Envio HyperIndex V3 indexer for Anoma Protocol Adapter events",
  "scripts": {
    "clean": "tsc --clean",
    "build": "tsc --build",
    "codegen": "pnpm envio codegen",
    "dev": "pnpm envio dev",
    "start": "envio start",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "envio": "3.9.0",
    "viem": "^2.55.17"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "5.2.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
