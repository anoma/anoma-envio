# V3 indexer image for the 512 MB memory measurement (Q2 of the envio-v3 migration).
# Based on the reference feat/hyperindex-v3 Dockerfile, with three deltas needed to
# actually RUN on this stack:
#   1. ca-certificates — bookworm-slim ships none; envio's HyperSync TLS fails without it.
#   2. NODE_OPTIONS=--import tsx — envio 3.2.1's HandlerLoader registers tsx via the
#      deprecated module.register("tsx/esm"), which tsx 4.21 rejects on Node 22 and envio
#      swallows; pre-registering tsx via --import is the working path. (tsx added as a
#      direct devDep so it resolves at top-level node_modules for --import.)
#   3. testnet config.demo.yaml baked (the actual demo workload), not mainnet config.yaml.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable && corepack install --global pnpm@9.15.9

COPY package.json pnpm-lock.yaml ./
# --no-frozen-lockfile: package.json was edited (type:module, tsx, dropped generated link)
# after the last lock refresh; tolerate the drift rather than fail the build.
RUN pnpm install --no-frozen-lockfile

COPY . .

# Bake the testnet demo scope at build time (codegen reads config -> .envio types).
RUN pnpm exec envio codegen --config config.demo.yaml

ENV NODE_OPTIONS="--import tsx"
ENV TUI_OFF=true

EXPOSE 9898

CMD ["pnpm", "exec", "envio", "start", "--config", "config.demo.yaml"]
